{
  "info": {
    "name": "SmartBike Mobile Backend API",
    "description": "Endpoint tests for the redback-smartbike-mobile-back-end Express API. Validation requests need no data. Happy-path requests read from your Supabase project. Write requests run only when the environment variable runWrites is 'true' and userId/otherUserId are real profiles.id values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Global",
      "item": [
        {
          "name": "Unknown API route -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/does-not-exist",
              "host": ["{{baseUrl}}"],
              "path": ["api", "does-not-exist"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('is JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
                  "pm.test('message matches', function () { pm.expect(pm.response.json().message).to.eql('API route not found'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid JSON body -> 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"broken\": "
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('is JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
                  "pm.test('message matches', function () { pm.expect(pm.response.json().message).to.eql('Invalid JSON body'); });"
                ]
              }
            }
          ]
        }
      ]
    },
