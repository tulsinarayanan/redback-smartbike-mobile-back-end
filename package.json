{
    "name": "redback-smartbike-mobile-back-end",
    "version": "1.0.0",
    "description": "Backend for Smartbike project to connect the front end (redback-smartbike-mobile-front-end), IoT and the VR game",
    "type": "module",
    "main": "app.js",
    "scripts": {
        "start": "node app.js",
        "dev": "nodemon app.js",
        "test:api": "newman run postman/SmartBike-API.postman_collection.json -e postman/local.postman_environment.json --env-var baseUrl=${BASE_URL:-http://localhost:5000} --env-var runWrites=${RUN_WRITES:-false} --reporters cli",
        "test:api:writes": "RUN_WRITES=true npm run test:api"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yjsjade/redback-smartbike-mobile-back-end.git"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.106.1",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "mqtt": "^5.15.1",
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "newman": "^6.2.1",
        "nodemon": "^3.1.14"
        "nodemon": "^3.1.14",
        "socket.io-client": "^4.8.3"
    }
}
